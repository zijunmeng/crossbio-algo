{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crossbio-algo/schemas/stage-schemas.json",
  "title": "crossbio-algo stage artifact (machine-checkable, SINGLE SOURCE OF TRUTH)",
  "description": "The one canonical schema for every stage's artifact.json. Per-stage stage_fields are enforced via oneOf over `stage` — a design artifact missing objective_or_likelihood FAILS validation here. This is the P0-2 fix: stage_fields no longer accepts arbitrary content. NOTE on the design stage: the human-readable design contract has 15 required + 2 optional = 17 fields (see algorithm-design SKILL), but the MACHINE payload (stage_fields below) carries only the 7 that participate in cross-stage validation; the other 10 are prose-only. Cross-stage CONTENT rules (estimand continuity, failure_boundary->acceptance, notation match, pseudocode->code, provenance) are enforced by the validator (artifact-validation.md); this schema enforces each stage's intra-stage structure plus the structural preconditions those rules need (failure_boundaries[].id, acceptance_criteria[].traces_to, provenance_hash pattern).",
  "type": "object",
  "required": ["artifact_id", "stage", "parent_artifact_id", "skill_version", "provenance_hash", "stage_fields"],
  "properties": {
    "artifact_id": {"type": "string", "description": "unique id, e.g. 'design-scout-001'"},
    "parent_artifact_id": {"type": ["string", "null"], "description": "upstream artifact this derives from; null ONLY for the data-audit root"},
    "skill_version": {"type": "string"},
    "model": {"type": "string"},
    "created_at": {"type": "string"},
    "provenance_hash": {"type": "string", "pattern": "^[a-f0-9]{12}$", "description": "sha256(canonical_json(content))[:12]"},
    "inputs": {"type": "object"},
    "decision": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "stage": {"enum": ["data-audit", "method-tension", "brainstorm", "viability", "design", "spec", "code", "audit"]}
  },
  "additionalProperties": true,
  "oneOf": [
    {"properties": {"stage": {"const": "data-audit"}, "stage_fields": {"$ref": "#/$defs/data_audit_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "method-tension"}, "stage_fields": {"$ref": "#/$defs/method_tension_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "brainstorm"}, "stage_fields": {"$ref": "#/$defs/brainstorm_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "viability"}, "stage_fields": {"$ref": "#/$defs/viability_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "design"}, "stage_fields": {"$ref": "#/$defs/design_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "spec"}, "stage_fields": {"$ref": "#/$defs/spec_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "code"}, "stage_fields": {"$ref": "#/$defs/code_fields"}}, "required": ["stage", "stage_fields"]},
    {"properties": {"stage": {"const": "audit"}, "stage_fields": {"$ref": "#/$defs/audit_fields"}}, "required": ["stage", "stage_fields"]}
  ],
  "$defs": {
    "data_audit_fields": {
      "description": "GATE root. estimand propagates to ALL downstream; fatal_issues non-empty = chain does not continue.",
      "type": "object",
      "required": ["biological_unit", "estimand", "fatal_issues", "cohort_structure", "leakage_graph", "split_strategy"],
      "properties": {
        "biological_unit": {"type": "string"},
        "estimand": {"type": "string"},
        "fatal_issues": {"type": "array", "items": {"type": "string"}},
        "cohort_structure": {"type": "string"},
        "leakage_graph": {"type": "string"},
        "split_strategy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "method_tension_fields": {
      "description": "Method tension miner (v0.4.0): evidence-traceable methodological tensions + falsifiable competing hypotheses. NO_QUALIFIED_TENSION is a VALID outcome (P5: no forced novelty). The validator checks structure and traceability — NOT scientific truth or novelty (P6). Evidence_status/novelty_status enums deliberately contain NO 'first/novel' value (rule: validator never upgrades novelty claims).",
      "type": "object",
      "required": ["scope", "search_protocol", "method_cards", "evidence_items", "tensions", "result_status", "limitations"],
      "properties": {
        "scope": {
          "type": "object",
          "required": ["research_question", "data_regime", "target_tier", "literature_cutoff_date"],
          "properties": {
            "research_question": {"type": "string"},
            "data_regime": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "target_tier": {"type": "string", "enum": ["T1", "T2", "T3", "T4"]},
            "literature_cutoff_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          },
          "additionalProperties": true
        },
        "search_protocol": {
          "type": "object",
          "required": ["sources", "queries", "searched_at", "coverage_limitations"],
          "properties": {
            "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "queries": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "searched_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "coverage_limitations": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "method_cards": {
          "type": "array", "minItems": 1,
          "items": {"type": "object",
            "required": ["method_id", "name", "estimand", "analysis_unit", "assumptions", "validated_regimes", "reported_limitations", "evidence_refs"],
            "properties": {
              "method_id": {"type": "string"},
              "name": {"type": "string"},
              "estimand": {"type": "string"},
              "analysis_unit": {"type": "string"},
              "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "validated_regimes": {"type": "array", "items": {"type": "string"}},
              "reported_limitations": {"type": "array", "items": {"type": "string"}},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true}
        },
        "evidence_items": {
          "type": "array", "minItems": 1,
          "items": {"type": "object",
            "required": ["evidence_id", "source_type", "title", "year", "doi_or_url", "locator", "claim_supported", "evidence_strength"],
            "properties": {
              "evidence_id": {"type": "string"},
              "source_type": {"type": "string", "enum": ["primary_paper", "review", "supplement", "code", "benchmark"]},
              "title": {"type": "string"},
              "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
              "doi_or_url": {"type": "string"},
              "locator": {"type": "string", "description": "section / table / figure / code path — where in the source the claim lives"},
              "claim_supported": {"type": "string"},
              "evidence_strength": {"type": "string", "enum": ["direct", "indirect"]},
              "notes": {"type": "string"}
            },
            "additionalProperties": true}
        },
        "tensions": {
          "type": "array",
          "items": {"type": "object",
            "required": ["tension_id", "type", "evidence_status", "claim", "method_refs", "evidence_refs", "mechanism_hypotheses", "predictions", "discriminating_experiment", "falsification_criteria", "impact_if_true", "impact_if_false", "novelty_status", "confidence_rationale"],
            "properties": {
              "tension_id": {"type": "string", "pattern": "^TENS-[0-9]{3,}$"},
              "type": {"type": "string", "enum": ["empirical_contradiction", "assumption_conflict", "unvalidated_interaction", "information_loss", "estimand_mismatch", "identifiability_boundary", "benchmark_blind_spot"]},
              "evidence_status": {"type": "string", "enum": ["observed", "literature_inferred", "unverified"]},
              "claim": {"type": "string"},
              "method_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "mechanism_hypotheses": {"type": "array", "minItems": 1,
                "items": {"type": "object",
                  "required": ["hypothesis", "supporting_evidence_refs", "alternative_explanations"],
                  "properties": {
                    "hypothesis": {"type": "string"},
                    "supporting_evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                    "alternative_explanations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
                  },
                  "additionalProperties": true}},
              "predictions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "discriminating_experiment": {"type": "string", "minLength": 20, "description": "'validate on more data' / 'compare algorithms' are NOT discriminating experiments — state which result supports which competing explanation"},
              "falsification_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "impact_if_true": {"type": "string"},
              "impact_if_false": {"type": "string"},
              "novelty_status": {"type": "string", "enum": ["known_related_work", "possible_overlap", "not_found_in_scoped_search", "expert_review_required"]},
              "nearest_related_work": {"type": "array", "items": {"type": "string"}},
              "confidence_rationale": {"type": "string"},
              "conflict_regime": {"type": "array", "items": {"type": "string"}, "description": "REQUIRED (content rule) for type=assumption_conflict — the data regimes where the assumptions clash"},
              "condition_evidence": {"type": "object", "description": "REQUIRED (content rule) for type=unvalidated_interaction — {condition: [evidence_id, ...]}: what evidence exists for EACH condition separately"}
            },
            "additionalProperties": true}
        },
        "result_status": {"type": "string", "enum": ["qualified_tensions_found", "no_qualified_tension", "blocked"]},
        "blocked_reason": {"type": "string", "description": "REQUIRED (content rule) when result_status=blocked — why the mining could not complete"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "brainstorm_fields": {
      "type": "object",
      "required": ["candidates", "chosen_id"],
      "properties": {
        "candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "hypothesis", "gap", "novelty_locus"], "additionalProperties": true}},
        "chosen_id": {"type": ["string", "integer"]}
      },
      "additionalProperties": true
    },
    "viability_fields": {
      "type": "object",
      "required": ["competitors_by_category", "viability_dimensions", "viability_total", "viability_range", "should_proceed"],
      "properties": {
        "competitors_by_category": {"type": "object"},
        "viability_dimensions": {"type": "object"},
        "viability_total": {"type": "number", "minimum": 0, "maximum": 1},
        "viability_range": {"type": "string"},
        "should_proceed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "design_fields": {
      "description": "Machine payload = 7 of the 17 contract fields (the cross-stage-validated subset). objective_or_likelihood + identifiability REQUIRED here — vocabulary-only abstraction without them is invalid.",
      "type": "object",
      "required": ["problem_definition", "estimand", "notation_and_shapes", "objective_or_likelihood", "identifiability", "failure_boundaries", "complexity"],
      "properties": {
        "problem_definition": {"type": "string"},
        "estimand": {"type": "string"},
        "notation_and_shapes": {"type": "object"},
        "objective_or_likelihood": {"type": "string"},
        "identifiability": {"type": "string"},
        "failure_boundaries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}, "additionalProperties": true}},
        "complexity": {"type": "string"}
      },
      "additionalProperties": true
    },
    "spec_fields": {
      "description": "Every acceptance_criterion carries an id, traces_to (failure_boundary ids), and a verification_mode — the basis of the executable-trace rules (DECLARED vs TESTED).",
      "type": "object",
      "required": ["module_interfaces", "acceptance_criteria", "pseudocode_hashes"],
      "properties": {
        "module_interfaces": {"type": "object"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "traces_to", "verification_mode"], "properties": {
          "id": {"type": "string"},
          "traces_to": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "verification_mode": {"type": "string", "enum": ["automated_test", "simulation", "benchmark", "analytic_argument", "documented_limitation", "external_validation"]},
          "test_aggregation": {"type": "string", "enum": ["all", "any"], "default": "all"}
        }, "additionalProperties": true}},
        "pseudocode_hashes": {"type": "object"}
      },
      "additionalProperties": true
    },
    "code_fields": {
      "description": "Executable trace: implementations carry real source hashes (recomputed from disk); tests link to acceptance_criteria ids with a real status — this is what makes DECLARED != TESTED detectable.",
      "type": "object",
      "required": ["module_hashes", "test_results", "acceptance_status", "implementations", "tests"],
      "properties": {
        "module_hashes": {"type": "object"},
        "test_results": {"type": "object"},
        "acceptance_status": {"type": "string"},
        "implementations": {"type": "array", "items": {"type": "object", "required": ["module", "source_file", "source_sha256", "module_sha256"], "properties": {
          "module": {"type": "string"},
          "source_file": {"type": "string"},
          "symbol": {"type": "string"},
          "source_sha256": {"type": "string"},
          "module_sha256": {"type": "string"}
        }, "additionalProperties": true}},
        "tests": {"type": "array", "items": {"type": "object", "required": ["test_id", "verifies_ac", "status"], "properties": {
          "test_id": {"type": "string"},
          "verifies_ac": {"type": "string"},
          "pytest_nodeid": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["passed", "failed", "known_limitation", "skipped"]}
        }, "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "audit_fields": {
      "type": "object",
      "required": ["panel_findings", "verdict", "blocking"],
      "properties": {
        "panel_findings": {"type": "array", "items": {"type": "object"}},
        "verdict": {"type": "string", "enum": ["pass", "needs_revision", "fail"]},
        "blocking": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
